# GEMINI_API_KEY: Required for server-side Gemini AI diagnostic assistance.
# Configured in AI Studio Secrets panel or Hostinger Node.js Environment Variables.
GEMINI_API_KEY=""

# APP_URL: Public URL where this application is hosted.
APP_URL="http://localhost:3000"

# PORT: Server port (3000 in development; Hostinger injects PORT automatically).
PORT="3000"

# SESSION_SECRET: Optional secret for signing clinician session tokens.
SESSION_SECRET=""

# ---------------------------------------------------------------------------
# Hostinger Business Plan — MySQL Database Configuration
# Leave DB_HOST empty for automatic embedded SQLite preview mode.
# On Hostinger Business Plan, set DB_HOST=127.0.0.1 and your hPanel MySQL credentials.
# ---------------------------------------------------------------------------
DB_HOST=""
DB_PORT="3306"
DB_USER=""
DB_PASSWORD=""
DB_NAME=""
